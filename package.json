{
  "name": "zotero-adobe-ocr",
  "type": "module",
  "version": "0.1.0",
  "description": "OCR PDFs using Adobe PDF Services API",
  "config": {
    "addonName": "Zotero Adobe OCR",
    "addonID": "zotero-adobe-ocr@tshippen",
    "addonRef": "zotero-adobe-ocr",
    "addonInstance": "ZoteroAdobeOCR",
    "prefsPrefix": "extensions.zotero.zotero-adobe-ocr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tshippen/zotero-adobe-ocr-plugin.git"
  },
  "author": "Tristan Shippen",
  "bugs": {
    "url": "https://github.com/tshippen/zotero-adobe-ocr-plugin/issues"
  },
  "homepage": "https://github.com/tshippen/zotero-adobe-ocr-plugin",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save",
    "prepare": "husky"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.3",
    "zotero-types": "^4.1.0-beta.4"
  },
  "lint-staged": {
    "*.{ts,mjs,js,json,xhtml,ftl,css}": "prettier --write",
    "*.{ts,mjs,js}": "eslint --fix"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
